              <mxPoint x="161" y="-534" />
              <mxPoint x="110" y="-534" />
              <mxPoint x="110" y="-617" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="JuAhdkXWAlsYraFpSnba-4" value="Направления на &lt;br&gt;обследование" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" connectable="0" vertex="1" parent="JuAhdkXWAlsYraFpSnba-3">
          <mxGeometry x="-0.3106" y="-1" relative="1" as="geometry">
            <mxPoint x="-24" y="-25" as="offset" />
