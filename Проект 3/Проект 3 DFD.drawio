        <mxCell id="V5p1KfwpkHX8d0-HZc2p-34" value="Запрос на цены" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" connectable="0" vertex="1" parent="V5p1KfwpkHX8d0-HZc2p-33">
